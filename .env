# Copy to .env (or .env.local) — Vite exposes VITE_* vars to the client.
# PocketBase has no separate public "anon key" the way Supabase does —
# access is governed entirely by each collection's API rules (see
# ../kirayu-server/pb_migrations), so this is the only variable needed.
VITE_POCKETBASE_URL=https://kirayu-server.krayonstore-gtd.store
